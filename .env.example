# demo works without credentials and never calls external services.
CHGK_MODE=demo
CHGK_GIGACHAT_CREDENTIALS=
CHGK_GIGACHAT_SCOPE=GIGACHAT_API_PERS
CHGK_MODEL=GigaChat-2
CHGK_SEARCH_ENABLED=true
# TLS verification is enabled by default. Both setting names are supported;
# CHGK_VERIFY_SSL takes precedence if both are supplied from the same source.
# GIGACHAT__VERIFY_SSL=false
# CHGK_VERIFY_SSL=false
# Optional trusted CA bundle when TLS verification is enabled.
# CHGK_CA_BUNDLE=/absolute/path/to/trusted-ca.pem
CHGK_MAX_ACTIVE_SESSIONS=4
CHGK_MODEL_CONCURRENCY=2
